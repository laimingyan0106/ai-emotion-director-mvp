# FastAPI
DATABASE_URL=postgresql://emotion:emotion@localhost:5432/emotion_director
CORS_ORIGINS=http://localhost:3000
STORAGE_MODE=auto
SQLITE_PATH=./.data/emotion-director.db
MEDIA_ROOT=./media
MEDIA_STORAGE_MODE=auto
ADAPTER_MODE=demo
GENERATION_RETRY_ATTEMPTS=1
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-terra
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
LLM_HTTP_RETRIES=2
LLM_API_KEY=
AUDIO_ANALYSIS_TIMEOUT_SECONDS=45
AUDIO_ANALYSIS_MAX_SECONDS=600
BLOB_READ_WRITE_TOKEN=

# Frontend. Leave blank to run the complete browser-only Demo Adapter.
NEXT_PUBLIC_API_BASE_URL=

# Optional image/video provider adapters
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_QUALITY=medium
IMAGE_SIZE=1280x720
IMAGE_TIMEOUT_SECONDS=150
VIDEO_API_KEY=
