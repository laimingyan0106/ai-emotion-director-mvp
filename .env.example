# FastAPI
DATABASE_URL=postgresql://emotion:emotion@localhost:5432/emotion_director
CORS_ORIGINS=http://localhost:3000
STORAGE_MODE=auto
SQLITE_PATH=./.data/emotion-director.db
MEDIA_ROOT=./media
MEDIA_STORAGE_MODE=auto
ADAPTER_MODE=demo
GENERATION_RETRY_ATTEMPTS=1
BLOB_READ_WRITE_TOKEN=

# Frontend. Leave blank to run the complete browser-only Demo Adapter.
NEXT_PUBLIC_API_BASE_URL=

# Provider adapters (leave blank to use the deterministic Demo Adapter)
LLM_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=
